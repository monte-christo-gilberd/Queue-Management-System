DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]
PORT=[port]
JWT_SECRET=[jwt-secret]
# Opsional, koma-dipisah. Kosong = hanya same-origin + klien tanpa Origin (mobile/Expo).
# Contoh: ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
ALLOWED_ORIGINS=
# Opsional, koma-dipisah IP/CIDR proxy tepercaya (mis. nginx). Kosong = X-Forwarded-For diabaikan.
TRUSTED_PROXIES=

# --- QR microservice ---
PUBLIC_APP_URL=https://app.example.com
PUBLIC_QR_URL=https://app.example.com
QR_SERVICE_URL=http://qr-service:8090
QR_SERVICE_TOKEN=[qr-service-internal-token]
QR_HTTP_TIMEOUT=1
