{{define "content"}}
      <h1 style="font-size:20px;margin:0 0 12px;">Buat password baru</h1>
      <p style="margin:0 0 12px;">Halo {{.Name}},</p>
      <p style="margin:0 0 16px;">Kami menerima permintaan untuk membuat password baru bagi akun Antrian Anda. Tautan berlaku {{.Minutes}} menit dan hanya bisa dipakai sekali.</p>
      <p style="margin:0 0 16px;"><a href="{{.Link}}" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:bold;">Buat password baru</a></p>
      <p style="margin:0 0 12px;color:#6b7280;font-size:12px;">Jika tombol tidak berfungsi, salin tautan ini ke browser:<br>{{.Link}}</p>
      <p style="margin:0;color:#6b7280;font-size:12px;">Jika Anda tidak memintanya, abaikan email ini. Password Anda tidak berubah.</p>
{{end}}
