{{define "content"}}
      <h1 style="font-size:20px;margin:0 0 12px;">Antrian dibatalkan</h1>
      <p style="margin:0 0 12px;">Halo {{.Name}},</p>
      <p style="margin:0 0 12px;">Nomor antrian Anda di <strong>{{.Queue}}</strong> telah dibatalkan. Nomor:</p>
      <p style="margin:0 0 16px;font-size:28px;font-weight:bold;letter-spacing:1px;">{{.Label}}</p>
      <p style="margin:0 0 12px;"><a href="{{.Link}}" style="color:#2563eb;">Lihat antrian</a></p>
      <p style="margin:0;color:#6b7280;font-size:12px;">Anda dapat mematikan notifikasi email di halaman Profil.</p>
{{end}}
