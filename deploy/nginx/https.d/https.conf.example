# Dipasang oleh scripts/mkcert-dev.sh (disalin menjadi https.conf, sertifikat di folder ini).
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/https.d/qms.pem;
    ssl_certificate_key /etc/nginx/https.d/qms-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/server.conf;
}
