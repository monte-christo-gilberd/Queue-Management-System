            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never",
            "gradientMode": "none",
            "axisBorderShow": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
