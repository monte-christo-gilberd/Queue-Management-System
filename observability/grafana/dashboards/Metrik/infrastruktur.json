    {
      "id": 27,
      "type": "timeseries",
      "title": "Memori container (10 teratas)",
      "description": "container_memory_working_set_bytes per container. Container dikenali dari id (12 karakter pertama sama dengan `docker ps`), karena cAdvisor tidak memakai docker.sock.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (container_id) (container_memory_working_set_bytes{container_id!=\"\"}))",
          "legendFormat": "{{container_id}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
