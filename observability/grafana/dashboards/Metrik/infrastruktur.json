    {
      "id": 29,
      "type": "table",
      "title": "Container start ulang (1 jam)",
      "description": "Berapa kali waktu start container berubah dalam 1 jam terakhir, per id container. Lebih dari 3 berarti container crash berulang.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort_desc(changes(container_start_time_seconds{container_id!=\"\"}[1h]) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Nilai"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
