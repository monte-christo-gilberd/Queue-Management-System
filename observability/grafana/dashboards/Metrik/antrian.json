              "group": "A"
            },
            "showPoints": "never",
            "gradientMode": "none",
            "axisBorderShow": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "backend"
            },
            "properties": [
              {
                "id": "color",
