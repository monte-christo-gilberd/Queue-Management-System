    {
      "id": 8,
      "type": "table",
      "title": "Route dengan respons 4xx/5xx",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Kombinasi service, route, dan status 4xx/5xx terbanyak pada rentang waktu terpilih (maks. 15).",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(15, sum by (service, route, status) (count_over_time({service=~\"$service\"} | status=~\"[45]..\" | route!=\"\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Jumlah",
              "service": "Service",
              "route": "Route",
              "status": "Status"
            },
            "indexByName": {
              "service": 0,
              "route": 1,
              "status": 2,
              "Value": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Jumlah",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Log ERROR dan WARN",
      "description": "Hanya level ERROR dan WARN dari service yang dipilih. Isi log berformat JSON utuh; klik baris untuk melihat field (request_id, route, status, ...).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=~\"$service\", level=~\"ERROR|WARN\"} |~ \"(?i)$search\" | request_id=~\".*$request_id.*\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false
      }
    },
