# Salin ke .env lalu ganti SEMUA nilai. Jangan commit .env.
# Buat rahasia acak:  openssl rand -hex 32

# Mode aplikasi. Kosong = development; production = service menolak start bila konfigurasinya tidak aman.
APP_ENV=production

# Alamat publik lewat Cloudflare Tunnel (harus https). Dipakai sebagai
# ALLOWED_ORIGINS dan PUBLIC_APP_URL (isi QR).
QMS_PUBLIC_ORIGIN=https://qms.montechristo.my.id
# Port di host tempat nginx (pintu masuk aplikasi) dibuka. Bawaan 8080.
QMS_HTTP_PORT=8080

# Nama user utama PostgreSQL (container db). Dipakai saat database pertama kali dibuat.
POSTGRES_USER=qms
# Password user utama PostgreSQL (container db).
POSTGRES_PASSWORD=GANTI_openssl_rand_hex_24
# Nama database aplikasi di PostgreSQL.
POSTGRES_DB=qms_db

# Token login (JWT RS256): kunci dibuat scripts/gen-auth-keys.sh (otomatis oleh `make prod-up`) di keys/. Tidak ada
# JWT_SECRET lagi. HANYA masa transisi dari versi lama: isi dengan JWT_SECRET lama (min 32 karakter) agar token yang
# sudah terbit tetap sah sampai kedaluwarsa (24 jam), lalu KOSONGKAN. Kosong = token HS256 ditolak.
JWT_LEGACY_HS256_SECRET=
# Login dengan Google (opsional; kosong = tombol disembunyikan dan rute tidak dipasang). Client ID bukan rahasia.
# Lihat documentation/docs/setup-google-login.md. GOOGLE_CLIENT_IDS dibaca auth-service; EXPO_PUBLIC_* dibakar ke
# bundle frontend saat build (ubah berarti build ulang).
GOOGLE_CLIENT_IDS=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Password role database auth_rw (auth-service: hanya users dan user_action_tokens). Wajib.
# DB prod lama: docker compose -f docker-compose.prod.yml exec -T -e AUTH_DB_PASSWORD="$AUTH_DB_PASSWORD" db sh < db/migrations/06_auth_role.sh
AUTH_DB_PASSWORD=GANTI_openssl_rand_hex_24
# Token rahasia komunikasi backend <-> qr-service. Nilainya harus sama di kedua sisi.
QR_SERVICE_TOKEN=GANTI_openssl_rand_hex_32
# Kunci rahasia penanda link QR (join). Hanya qr-service yang memakainya.
JOIN_LINK_SECRET=GANTI_openssl_rand_hex_32
# Password role database notify_ro (hanya baca) untuk notify-service (Web Push).
NOTIFY_DB_PASSWORD=GANTI_openssl_rand_hex_24
# Password role mail_rw (pengirim email). Dipakai saat database prod PERTAMA dibuat; untuk DB yang sudah ada, buat role
# dengan db/migrations/04_mail_role.sh (lihat README).
MAIL_DB_PASSWORD=GANTI_openssl_rand_hex_24
# Masa berlaku (detik) tiap kode QR dinamis sebelum diganti. Rentang 30-600.
QR_DYNAMIC_TTL_SECONDS=120

# --- payment-service (perpanjang langganan owner 1 bulan lewat Stripe) ---
# TERPISAH dari antrian: backend tidak memanggilnya, jadi bila service ini mati atau Stripe belum diisi, antrian
# tetap jalan (hanya perpanjangan yang tertunda). Nilai kosong/GANTI membuat pembayaran dinonaktifkan, bukan
# menggagalkan `make prod-up`.
# Password role payment_rw. Dipakai saat DB prod PERTAMA dibuat; untuk DB yang sudah ada buat rolenya dengan
# docker compose -f docker-compose.prod.yml exec -T -e PAYMENT_DB_PASSWORD="$PAYMENT_DB_PASSWORD" db sh < db/migrations/05_payment_role.sh
PAYMENT_DB_PASSWORD=GANTI_openssl_rand_hex_24
# Stripe: sk_live_... (produksi) atau sk_test_... (uji tanpa uang sungguhan). Kosongkan STRIPE_API_BASE_URL.
STRIPE_API_KEY=GANTI
# whsec_... dari endpoint webhook https://<domain>/api/v1/payments/webhooks/stripe di dashboard Stripe
# (event: checkout.session.completed, checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=GANTI
# Opsional: ID Price Stripe untuk 1 bulan. Kosong = harga inline dari dua nilai di bawah.
# STRIPE_PRICE_ID=
SUBSCRIPTION_PRICE_AMOUNT=50000
# Kode mata uang langganan (ISO 4217, huruf kecil), mis. idr.
SUBSCRIPTION_CURRENCY=idr

# Web Push: buat pasangan kunci baru untuk produksi, jangan pakai kunci dev.
VAPID_PUBLIC_KEY=
# Kunci privat VAPID untuk menandatangani Web Push. Rahasia, jangan dibagikan.
VAPID_PRIVATE_KEY=
# Identitas pengirim Web Push, format mailto: atau https:.
VAPID_SUBJECT=mailto:GANTI@email-anda

# --- Email (mail-service) ---
# MAIL_MODE memilih ke mana email pergi (dibaca oleh `make prod-up`; diperiksa scripts/check-mail-mode.sh):
#   smtp     SMTP nyata ke penerima sebenarnya (bawaan). Isi SMTP_* di bawah.
#   mailpit  Demo/uji: email ditangkap Mailpit dan TIDAK dikirim ke siapa pun. SMTP_* di bawah diabaikan.
#            UI hanya di 127.0.0.1:8025 server ini (bukan lewat nginx/Cloudflare); buka dengan SSH tunnel:
#            ssh -L 8025:127.0.0.1:8025 <user>@<host>  lalu  http://localhost:8025
MAIL_MODE=smtp
# MAILPIT_UI_PORT=8025   # port UI Mailpit di server (127.0.0.1), hanya mode mailpit
# Token pemanggil -> mail-service, WAJIB di kedua mode, minimal 32 karakter acak: openssl rand -hex 32
MAIL_SERVICE_TOKEN=GANTI

# Hanya MAIL_MODE=smtp: service menolak start bila tidak lengkap.
# Contoh Gmail/Google Workspace: smtp.gmail.com, 587, starttls, kata sandi aplikasi. Contoh penyedia transaksional
# (Brevo, Mailgun, SES): host dan kredensial dari dashboard mereka. SMTP_FROM harus alamat dari domain yang
# diverifikasi penyedia (SPF/DKIM) agar tidak masuk spam.
# Gmail: SMTP_USER dan SMTP_FROM memakai alamat Gmail yang sama (mis. Antrian <akun@gmail.com>), SMTP_PASSWORD = kata sandi
# aplikasi 16 karakter (butuh verifikasi 2 langkah), bukan kata sandi akun. Batas kirim Gmail sekitar 500 email per hari.
SMTP_HOST=GANTI-smtp.penyedia.com
# Port server SMTP (587 untuk starttls, 465 untuk tls, 1025 untuk Mailpit).
SMTP_PORT=587
# Alamat dan nama pengirim yang tampil di email.
SMTP_FROM=Antrian <no-reply@GANTI-domain-anda>
# Username login SMTP. Kosong bila server tidak memerlukan login (mis. Mailpit).
SMTP_USER=GANTI
# Password login SMTP (untuk Gmail: app password, bukan password akun).
SMTP_PASSWORD=GANTI
# starttls (587) atau tls (465). "none" hanya untuk dev.
SMTP_TLS=starttls

# Tingkat log: debug, info, warn, atau error.
LOG_LEVEL=info
# Batas waktu (detik) backend menunggu balasan dari qr-service.
QR_HTTP_TIMEOUT=1
# Detik menunggu request selesai saat backend berhenti (harus < stop_grace_period 10s di docker-compose.prod.yml)
SHUTDOWN_TIMEOUT=8
# Verifikasi email (kosong = nyala). Email terkirim sesuai MAIL_MODE: smtp = inbox asli (mis. Gmail), mailpit = ditangkap
# Mailpit dan tidak terkirim ke siapa pun (pengguna baru lalu butuh `make verify-user EMAIL=...` atau akses Mailpit).
# `false` mematikan verifikasi: semua akun dianggap terverifikasi.
EMAIL_VERIFICATION_REQUIRED=
