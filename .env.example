# Salin ke .env lalu isi nilai asli. Jangan commit .env.
# Dipakai docker compose (interpolasi variabel) — bukan dibaca langsung oleh service.

# --- Database ---
# Nama user utama PostgreSQL (container db). Dipakai saat database pertama kali dibuat.
POSTGRES_USER=qms
# Password user utama PostgreSQL (container db).
POSTGRES_PASSWORD=change-me-db-password
# Nama database aplikasi di PostgreSQL.
POSTGRES_DB=qms_db

# --- Token login (JWT RS256) ---
# Token login diterbitkan auth-service dengan KUNCI PRIVAT dan diverifikasi backend secara
# lokal dengan KUNCI PUBLIK (keys/auth-public.pem untuk prod; keys-dev/ untuk dev). Kunci dibuat scripts/gen-auth-keys.sh (otomatis oleh `make up`),
# tidak ada yang perlu diisi di sini. Tidak ada JWT_SECRET lagi.

# --- auth-service (login, registrasi, reset password, verifikasi email) ---
# TERPISAH dari backend: backend tidak memanggilnya. Bila mati, user yang sudah login tetap bisa memakai aplikasi.
# Password role database auth_rw (hanya tabel users dan user_action_tokens). Buat acak. Wajib.
# DB dev lama: buat rolenya dengan `docker compose exec -T -e AUTH_DB_PASSWORD="$AUTH_DB_PASSWORD" db sh < db/migrations/06_auth_role.sh`
AUTH_DB_PASSWORD=change-me-auth-db-password

# --- qr-service ---
# Minimal 32 byte acak. Hanya qr-service yang memegang secret ini.
JOIN_LINK_SECRET=change-me-join-link-secret-at-least-32-bytes
# Token service-to-service (backend <-> qr-service). Panjang dan acak.
QR_SERVICE_TOKEN=change-me-service-token-at-least-32-bytes
# Masa berlaku (detik) tiap kode QR dinamis sebelum diganti. Rentang 30-600.
QR_DYNAMIC_TTL_SECONDS=120

# --- notify-service (Web Push) ---
# Password role database notify_ro (hanya baca). Buat acak.
NOTIFY_DB_PASSWORD=change-me-notify-db-password
# Kunci VAPID: buat dengan `npx web-push generate-vapid-keys` atau webpush-go GenerateVAPIDKeys.
VAPID_PUBLIC_KEY=change-me
# Kunci privat VAPID untuk menandatangani Web Push. Rahasia, jangan dibagikan.
VAPID_PRIVATE_KEY=change-me
# Identitas pengirim Web Push, format mailto: atau https:.
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (mail-service) ---
# Password role database mail_rw (worker outbox; hanya baca outbox dan email pengguna). Buat acak.
# DB dev lama: buat rolenya dengan `docker compose exec -T -e MAIL_DB_PASSWORD="$MAIL_DB_PASSWORD" db sh < db/migrations/04_mail_role.sh`
MAIL_DB_PASSWORD=change-me-mail-db-password
# --- Login dengan Google (auth-service + frontend) ---
# Opsional. Kosong = tombol Google disembunyikan dan rute /users/google tidak dipasang. Setup manual di Google Cloud:
# lihat documentation/docs/setup-google-login.md. Client ID bukan rahasia.
# Backend (auth-service): client ID yang sah untuk klaim `aud` ID token, dipisah koma (web, Android, iOS).
GOOGLE_CLIENT_IDS=
# Frontend: client ID per platform. Web wajib untuk browser; Android dan iOS untuk aplikasi native (butuh dev build).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# HANYA tes lokal: alamat kunci publik Google (mis. server palsu). Kosong = alamat resmi Google.
# GOOGLE_CERTS_URL=

# Token layanan (pemanggil -> mail-service, header X-Service-Token). Minimal 32 karakter, acak: openssl rand -hex 32
MAIL_SERVICE_TOKEN=change-me-mail-service-token-at-least-32-bytes
# Dev: Mailpit menangkap semua email (UI di http://localhost:8025, hanya dari mesin ini). Nilai SMTP di bawah
# adalah bawaan compose dev; tidak perlu diubah. Produksi: isi dengan SMTP nyata (lihat .env.prod.example).
SMTP_HOST=mailpit
# Port server SMTP (587 untuk starttls, 465 untuk tls, 1025 untuk Mailpit).
SMTP_PORT=1025
# Alamat dan nama pengirim yang tampil di email.
SMTP_FROM=Antrian <no-reply@qms.local>
# Username login SMTP. Kosong bila server tidak memerlukan login (mis. Mailpit).
SMTP_USER=
# Password login SMTP (untuk Gmail: app password, bukan password akun).
SMTP_PASSWORD=
# none (Mailpit), starttls (port 587), atau tls (port 465)
SMTP_TLS=none
# Port Mailpit di host (hanya 127.0.0.1). Ubah bila bentrok dengan proyek lain.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# --- Publik ---
# Origin yang dibuka browser/HP, mis. http://192.168.1.11:8080 untuk uji LAN.
# Harus sama dengan cara pengguna mengakses nginx agar QR bisa dipindai dari HP.
QMS_PUBLIC_ORIGIN=http://localhost:8080
# Port di host tempat nginx (pintu masuk aplikasi) dibuka. Bawaan 8080.
QMS_HTTP_PORT=8080

# Kosongkan untuk dev. "production" membuat backend menolak start bila
# QR_SERVICE_TOKEN < 32 karakter atau default, atau origin bukan https.
# Lihat .env.prod.example.
APP_ENV=

# --- Opsional ---
# Tingkat log: debug, info, warn, atau error.
LOG_LEVEL=info
# Batas waktu (detik) backend menunggu balasan dari qr-service.
QR_HTTP_TIMEOUT=1
# Detik menunggu request selesai saat backend berhenti (bawaan: 2 di compose dev, 8 di prod; harus < stop_grace_period)
# SHUTDOWN_TIMEOUT=2
# Verifikasi email (kosong = nyala; email verifikasi masuk ke Mailpit di dev). `false` mematikan: semua akun dianggap terverifikasi.
# EMAIL_VERIFICATION_REQUIRED=

# =====================================================================
# Menjalankan service DI LUAR Docker (opsional)
# backend dan qr-service yang dijalankan langsung (go run / binary lokal)
# memuat file .env di folder akar ini (../.env dari folder service). Salin ke .env lalu
# aktifkan (hapus #) baris yang dibutuhkan. QR_SERVICE_TOKEN dan JOIN_LINK_SECRET
# harus SAMA dengan yang di atas.
# Prefiks BACKEND_ dan QR_ dipakai karena PORT dan DATABASE_URL dipakai lebih dari satu service.
# Docker Compose tidak memakai bagian ini.
# =====================================================================

# --- backend ---
# BACKEND_PORT=8080
# BACKEND_DATABASE_URL=postgresql://qms:change-me-db-password@localhost:5432/qms_db
# Koma-dipisah. Kosong = hanya same-origin + klien tanpa Origin (mobile/Expo).
# ALLOWED_ORIGINS=http://localhost:8080
# Koma-dipisah IP/CIDR proxy tepercaya (mis. nginx). Kosong = X-Forwarded-For diabaikan.
# TRUSTED_PROXIES=
# PUBLIC_APP_URL=http://localhost:8080
# QR_SERVICE_URL=http://localhost:8090
# QR_HTTP_TIMEOUT=1

# --- qr-service ---
# QR_PORT=8090


# --- Observability (opsional; hanya dipakai `make obs-up`, lihat docker-compose.observability.yml) ---
# Password admin Grafana. WAJIB bila memakai overlay, tanpa nilai bawaan. Isi dengan nilai acak yang panjang.
GRAFANA_ADMIN_PASSWORD=
# Port Grafana di 127.0.0.1 host (kosong = 3000). Tidak dibuka ke LAN atau internet.
GRAFANA_PORT=
# Password role database metrics_ro untuk postgres_exporter. WAJIB bila memakai overlay, tanpa nilai bawaan.
# Role dibuat atau diperbarui otomatis oleh `make obs-up` (db/migrations/07_metrics_role.sh). Nilai acak yang panjang.
METRICS_DB_PASSWORD=
# Lama simpan log di Loki (kosong = 168h, yaitu 7 hari).
OBS_LOG_RETENTION=
# Lama simpan metrik di Prometheus (kosong = 7d). Batas ukuran tetap 1GB.
OBS_METRICS_RETENTION=
# Lama simpan trace di Tempo (kosong = 72h, yaitu 3 hari).
OBS_TRACE_RETENTION=
# Rasio trace yang direkam (head sampling): kosong = 0.1 (10%), 1 = semua, 0 = tidak ada. Alamat pengirim trace
# (OTEL_EXPORTER_OTLP_ENDPOINT) diisi otomatis oleh overlay observability; JANGAN diisi di sini, supaya tanpa overlay
# tracing tetap mati.
OTEL_TRACES_SAMPLER_ARG=
