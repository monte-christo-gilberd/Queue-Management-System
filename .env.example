# Salin ke .env lalu isi nilai asli. Jangan commit .env.
# Dipakai docker compose (interpolasi variabel) — bukan dibaca langsung oleh service.

# --- Database ---
POSTGRES_USER=qms
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=qms_db

# --- Backend ---
JWT_SECRET=change-me-jwt-secret

# --- qr-service ---
# Minimal 32 byte acak. Hanya qr-service yang memegang secret ini.
JOIN_LINK_SECRET=change-me-join-link-secret-at-least-32-bytes
# Token service-to-service (backend <-> qr-service). Panjang dan acak.
QR_SERVICE_TOKEN=change-me-service-token-at-least-32-bytes
QR_DYNAMIC_TTL_SECONDS=120

# --- notify-service (Web Push) ---
# Password role database notify_ro (hanya baca). Buat acak.
NOTIFY_DB_PASSWORD=change-me-notify-db-password
# Kunci VAPID: buat dengan `npx web-push generate-vapid-keys` atau webpush-go GenerateVAPIDKeys.
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com

# --- Publik ---
# Origin yang dibuka browser/HP, mis. http://192.168.1.11:8080 untuk uji LAN.
# Harus sama dengan cara pengguna mengakses nginx agar QR bisa dipindai dari HP.
QMS_PUBLIC_ORIGIN=http://localhost:8080
QMS_HTTP_PORT=8080

# Kosongkan untuk dev. "production" membuat backend menolak start bila
# JWT_SECRET/QR_SERVICE_TOKEN < 32 karakter atau default, atau origin bukan https.
# Lihat .env.prod.example.
APP_ENV=

# --- Opsional ---
LOG_LEVEL=info
QR_HTTP_TIMEOUT=1

# =====================================================================
# Menjalankan service DI LUAR Docker (opsional)
# `.env` tetap per folder. Salin bagian yang relevan ke file .env di folder
# service itu. Nilai JWT_SECRET, QR_SERVICE_TOKEN, JOIN_LINK_SECRET harus
# SAMA dengan yang di atas. Dengan Docker, bagian ini tidak dipakai.
# =====================================================================

# --- [backend/.env] ---
# DATABASE_URL=postgresql://qms:change-me-db-password@localhost:5432/qms_db
# PORT=8080
# JWT_SECRET=<sama dengan di atas>
# Koma-dipisah. Kosong = hanya same-origin + klien tanpa Origin (mobile/Expo).
# ALLOWED_ORIGINS=http://localhost:8080
# Koma-dipisah IP/CIDR proxy tepercaya (mis. nginx). Kosong = X-Forwarded-For diabaikan.
# TRUSTED_PROXIES=
# PUBLIC_APP_URL=http://localhost:8080
# QR_SERVICE_URL=http://localhost:8090
# QR_SERVICE_TOKEN=<sama dengan di atas>
# QR_HTTP_TIMEOUT=1

# --- [qr-service/.env] ---
# PORT=8090
# JOIN_LINK_SECRET=<sama dengan di atas, min 32 byte>
# QR_DYNAMIC_TTL_SECONDS=120   # rentang 30-600
# QR_SERVICE_TOKEN=<sama dengan di atas>
# LOG_LEVEL=info               # debug | info | warn | error

# --- [frontend/.env] ---
# EXPO_PUBLIC_API_URL=http://localhost:8080
