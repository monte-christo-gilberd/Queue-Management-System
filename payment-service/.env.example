# payment-service — dipakai bila service dijalankan DI LUAR Docker. Dengan Docker, nilainya datang dari
# docker-compose*.yml (variabel di .env akar proyek). Jangan commit .env.
#   cp .env.example .env

PORT=8093
# Role payment_rw (db/migrations/05_payment_role.sh), bukan role utama.
DATABASE_URL=postgresql://payment_rw:GANTI@localhost:5432/qms_db?sslmode=disable
# SAMA dengan JWT_SECRET backend (payment-service memverifikasi token login yang sama).
JWT_SECRET=GANTI
# Origin publik app; tujuan kembali dari Stripe Checkout (/subscription?payment=success|cancel).
QMS_PUBLIC_ORIGIN=http://localhost:8080
# "production" mewajibkan JWT_SECRET >= 32 karakter dan QMS_PUBLIC_ORIGIN https.
APP_ENV=

# HANYA DEV: pembayaran PALSU tanpa Stripe (checkout langsung berhasil). Ditolak bila APP_ENV=production atau bila
# kunci Stripe terisi.
DEV_PAYMENT_SIMULATOR=

# --- Stripe ---
# Kosong atau berawalan GANTI/change-me = pembayaran DIMATIKAN: service tetap hidup, checkout menjawab 503.
# Kunci sk_test_... = mode uji Stripe (tidak ada uang sungguhan). sk_live_... hanya di produksi.
STRIPE_API_KEY=
# whsec_... dari endpoint webhook di dashboard Stripe (atau `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Kosong = api.stripe.com. Dev dengan emulator: http://localhost:4000
STRIPE_API_BASE_URL=
# Opsional: ID Price Stripe untuk 1 bulan. Kosong = harga inline dari dua nilai di bawah.
STRIPE_PRICE_ID=
# Harga satu bulan dalam satuan utama (50000 = Rp50.000) dan mata uangnya.
SUBSCRIPTION_PRICE_AMOUNT=50000
SUBSCRIPTION_CURRENCY=idr
