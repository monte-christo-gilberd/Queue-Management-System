# Port HTTP service.
PORT=8090

# Origin frontend yang dipakai menyusun tautan join.
# Harus bisa dibuka dari HP yang memindai QR: jangan pakai localhost untuk uji perangkat.
PUBLIC_APP_URL=http://localhost:8081

# Secret HMAC untuk token join. Minimal 32 byte acak.
# Hanya qr-service yang memegang nilai ini.
JOIN_LINK_SECRET=change-me-to-a-random-string-at-least-32-bytes

# Masa berlaku token join dinamis (detik). Rentang 30-600.
QR_DYNAMIC_TTL_SECONDS=120

# Token service-to-service untuk endpoint /internal/v1/*.
# Nilai yang sama dipakai backend.
QR_SERVICE_TOKEN=change-me-to-a-long-random-service-token

# debug | info | warn | error
LOG_LEVEL=info
